# Copy this file to ".env" and fill in your own values.
# .env is gitignored. Never put a real key in this file — it IS committed.

# --- Model access (required) -------------------------------------------------
# The project talks to OpenRouter with the OpenAI SDK, for both chat and
# embeddings. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1

# The chat model: every node of the agent, and LightRAG's entity extraction.
# Changing it invalidates LightRAG's extractions, but its response cache is
# keyed WITHOUT the model name — delete data/graph_rag/kv_store_llm_response
# _cache.json before re-ingesting, or the old model's work is replayed.
LLM_MODEL=openai/gpt-4o-mini

# Reranks graph candidates against the question, after retrieval and before the
# LLM sees them. RERANK=false skips the step entirely.
RERANK_MODEL=cohere/rerank-v3.5

# --- Ingestion and retrieval -------------------------------------------------
# Where your source PDFs live.
RAW_DATA_DIR=data/raw

# The document trees: one JSON per PDF, the sections in the shape their author
# wrote them. This is the source of truth — data/chroma is derived from it, and
# deleting that costs a re-embed while deleting this costs a re-parse.
TREE_DIR=data/tree

# Where the Chroma vector database is persisted on disk.
CHROMA_DIR=data/chroma

# Two collections, deliberately apart: one embedding per graph chunk, and one
# per tree section over its heading path. They answer different questions —
# "which passage is about this" versus "which section is this" — so mixing
# both kinds of row into one collection would make every distance meaningless.
COLLECTION_NAME=documents
HEADING_COLLECTION_NAME=headings

# Embedding model, resolved through OpenRouter. Required: the fallback in
# src/rag/config.py is a sentence-transformers name OpenRouter cannot serve.
# Changing this invalidates the store — vectors from different models are not
# comparable — so re-ingest after.
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Tickets -----------------------------------------------------------------
# Where the filer writes ticket documents. Relative paths resolve from the
# project root.
TICKETS_DIR=data/tickets

# --- The HTTP API (optional) -------------------------------------------------
# Only read by `python scripts/serve.py`. Every one of these has a working
# default; the section exists so you know the knobs are there.
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated browser origins allowed to call the API. Empty (the default)
# means the CORS middleware is not installed at all — Swagger is served by the
# API itself and needs none. Set this only when a front end on another origin
# has to reach it.
API_CORS_ORIGINS=

# In-memory ceilings. Ingest jobs and agent conversations both live in the
# serving process, so both need one: finished jobs and idle conversations are
# evicted oldest-first past these.
API_MAX_JOBS=100
API_MAX_SESSIONS=100

# Turns kept per conversation. The transcript is replayed into every run, so
# this is a token budget as much as a memory one.
API_MAX_SESSION_TURNS=20

# --- Observability (optional) ------------------------------------------------
# Tracing is off unless both keys are set. Self-host Langfuse with its own
# docker compose, then take a key pair from Project Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# Keep the keys but stop sending: set to false.
LANGFUSE_TRACING_ENABLED=true

# Separates experiments from real runs in the Langfuse UI.
LANGFUSE_TRACING_ENVIRONMENT=development

# LightRAG patches the OpenAI SDK globally when it sees Langfuse keys, which
# makes every agent LLM call get traced twice. The duplicates are dropped
# unless you turn this on to debug LightRAG's own calls — see README.
LANGFUSE_TRACE_OPENAI_SDK=false
